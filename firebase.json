{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": {
      "port": 4200
    },
    "firestore": {
      "port": 4201
    },
    "ui": {
      "enabled": false
    },
    "hosting": {
      "port": 5002
    },
    "singleProjectMode": true
  }
}
