# AE Arcade — environment variables
# All four are read by Firebase Cloud Functions in functions/index.js.
# For local emulator use, copy this file to functions/.secret.local (gitignored)
# or set via `firebase functions:secrets:set` for production.
#
# WARNING: Never reuse a mainnet account that holds real value during
# local development. Generate dedicated test credentials per fork.

# Algorand mainnet account that holds the prize pool (Aether ASA).
# 58-char Algorand address.
ESCROW_ADDRESS=

# 25-word Algorand mnemonic for the ESCROW_ADDRESS account.
# Used server-side only to sign payout transactions.
ESCROW_PASSPHRASE=

# Discord incoming webhook URL for game-event notifications.
# Create one in your Discord server: Server Settings -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=

# Nodely (4160.nodely.dev) API token for Algorand mainnet algod + indexer access.
# Sign up at https://nodely.io and provision a token.
NODELY_API_TOKEN=
